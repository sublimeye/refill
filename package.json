{
  "name": "refill",
  "private": true,
  "version": "0.0.0",
  "description": "Private, encrypted form memory. Local-only.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "wxt": "0.21.5"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "typecheck": "svelte-check && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:manifest": "pnpm build && vitest run --config vitest.manifest.config.ts",
    "check:built-network": "node scripts/check-built-network.mjs .output/chrome-mv3",
    "check:no-frameworks": "node scripts/check-no-frameworks.mjs .output/chrome-mv3",
    "build:e2e": "wxt build --mode e2e",
    "test:e2e": "pnpm build:e2e && playwright test --pass-with-no-tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
